{
  "about": [
    "SF Kart vehicle data: everything the physics engine reads for each vehicle, packed into the engine's layouts at load time by src/app/vehicleData.ts.",
    "Stats are final (no driver bonuses are added on top). Units are the engine's: distances in world units (60 per meter on the San Francisco course), speeds per frame at 59.94 fps."
  ],
  "version": 2,
  "fields": {
    "class": "\"bike\" or \"kart\": which physics the engine runs (bikes wheelie and lean; karts slide).",
    "stats.body": "Body layout: \"kart\" (4 wheels), \"threeWheelKart\", \"bike\" (leans around the handlebar), \"bikeVehicleRelative\".",
    "stats.driftType": "\"outsideKart\", \"outsideBike\" (slides outward) or \"inside\" (leans into the turn, bikes).",
    "stats.weightClass": "\"light\", \"medium\" or \"heavy\": who wins a bump.",
    "stats.weight": "Mass for bumps between vehicles (not gravity).",
    "stats.bumpDeviation": "How much bumpy surfaces knock it sideways.",
    "stats.topSpeed": "Base top speed (units per frame).",
    "stats.steerSpeedKeep": "Fraction of speed kept at full steer (1 = no loss).",
    "stats.tilt": "How far the body tilts on slopes and in turns.",
    "stats.accel": "Acceleration curve: at standstill, then at each of accelSpeeds (fractions of top speed); beyond the last, the last value.",
    "stats.accelSpeeds": "Speed fractions where the curve reaches the next accel value.",
    "stats.driftAccel": "The acceleration curve while drifting.",
    "stats.driftAccelSpeeds": "Its speed fraction.",
    "stats.handlingManual": "Steering tightness outside drifts (manual drift controls).",
    "stats.handlingAuto": "Same, automatic drift controls.",
    "stats.handlingReactivity": "How quickly steering responds.",
    "stats.driftManual": "Turning tightness while drifting (manual).",
    "stats.driftAuto": "Same, automatic.",
    "stats.driftReactivity": "How quickly steering responds in a drift.",
    "stats.outsideDriftAngle": "Degrees sideways in an outside drift (0 for inside-drift bikes).",
    "stats.outsideDriftAngleStep": "How fast it swings to that angle (degrees per frame).",
    "stats.miniTurboFrames": "Mini-turbo boost length in frames (super mini-turbo: 3x).",
    "stats.surfaceSpeed": "Speed multiplier per collision surface type (0 road, 1 slippery, 2-4 weak/normal/heavy offroad, ...).",
    "stats.surfaceTurn": "Turning multiplier per surface type.",
    "stats.maxSuspensionForce": "Cap on the upward force from the suspension on landings.",
    "stats.megaSize": "Scale when grown to mega size.",
    "stats.shrinkSize": "Scale when shrunk.",
    "collision.rideHeight": "Height of the body origin above the ground at spawn.",
    "collision.hitboxes": "Spheres (pos, radius) the body collides with; wallsOnly ones touch walls only; tire = which wheel it belongs to.",
    "collision.inertiaBox": "Box (size, offset) the rotational inertia is computed from: bigger = slower to rotate.",
    "collision.spinFactor": "How strongly the body rotation follows collisions and landings.",
    "collision.wheels": "Suspension per wheel: pos, radius, collisionRadius, spring, damping, travel, tiltDeg. Karts mirror each to the other side.",
    "display.cameraHeight": "Lowers the chase camera for this vehicle.",
    "display.handlebarPos": "Bikes: the handlebar pivot the body leans around.",
    "display.handlebarRotDeg": "Bikes: its rotation (degrees).",
    "camera": "Chase camera (all vehicles): fov (degrees), distance behind, height, height of the look-at point."
  },
